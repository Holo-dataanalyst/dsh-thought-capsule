/**
 * Agent 面工具：capsule_add / capsule_list / capsule_update。
 *
 * 刻意「只有加、查、改」，没有删除工具：删条目必须由用户在面板里二次确认，
 * 避免模型自作主张抹掉用户的记录。
 *
 * 这里**不 import 任何 @deepseek-ai 包**（也不用 defineTool）：本机 profile
 * （E:\AI\DSHTauri\.dsh\profiles\tauri）的 Node 解析路径里没有宿主安装目录，
 * import @deepseek-ai/dsh-tools 会 MODULE_NOT_FOUND 并拖垮整个宿主半边。
 * 工具描述就是普通数据，直接交给 ctx.tools.register。
 */
import { CATEGORY_IDS, categoryLabel } from './classify.js';
import { addItem, listItems, updateItem } from './store.js';

const STATUS_LABELS = { inbox: '未整理', todo: '待办', done: '已完成' };

/** 工具描述表；enum 里的 __CATEGORY_IDS__ 在注册时替换成真实分类 id。 */
const TOOL_SPECS = [
  {
    "name": "capsule_add",
    "description": "把用户想到的一个点子、待办或待试的插件记进「思维胶囊」暂存箱（默认状态 inbox=未整理，按关键词自动分类，用户随后在左侧栏面板里整理）。当用户说\"记一下\"\"别忘了\"\"待会试试这个\"\"回头看看这个\"，或在干活时顺口提到某个插件/工具/链接/想法时调用。只记录用户实际说过的内容和关键细节，不要自行补全、改写或添加建议。",
    "parameters": {
      "text": {
        "type": "string",
        "description": "要记录的一句话，保留用户的原始说法和关键细节。",
        "required": true
      },
      "category": {
        "type": "string",
        "enum": [
          "__CATEGORY_IDS__"
        ],
        "description": "可选分类：不传则按关键词自动判断。"
      }
    },
    "run": "add"
  },
  {
    "name": "capsule_list",
    "description": "列出「思维胶囊」里的记录（默认最多 20 条，按创建时间从新到旧）。用户问\"我记的那些东西呢\"\"还有什么没做\"\"今天记了什么\"时调用。返回每条的状态、分类、时间和完整 id；要改某条就用 capsule_update，并且必须用返回的完整 id。",
    "parameters": {
      "status": {
        "type": "string",
        "enum": [
          "inbox",
          "todo",
          "done",
          "all"
        ],
        "description": "按状态过滤：inbox=未整理、todo=待办、done=已完成、all=全部。默认 all。"
      },
      "category": {
        "type": "string",
        "enum": [
          "__CATEGORY_IDS__"
        ],
        "description": "可选：按分类过滤。"
      },
      "limit": {
        "type": "integer",
        "description": "最多返回几条，默认 20，范围 1–200。"
      }
    },
    "run": "list"
  },
  {
    "name": "capsule_update",
    "description": "修改一条「思维胶囊」记录：改文字、改分类，或移动状态（inbox 未整理 → todo 待办 → done 已完成）。先用 capsule_list 拿到完整 id。用户说\"这条我做完了\"\"这个归到工作\"\"把它挪到待办\"时调用。没有删除能力：用户要删某条时，告诉他去左侧栏胶囊面板里手动删除。",
    "parameters": {
      "id": {
        "type": "string",
        "description": "要修改的卡片 id（capsule_list 返回值里的完整 uuid）。",
        "required": true
      },
      "text": {
        "type": "string",
        "description": "可选：新的文字内容（会 trim 后覆盖原文字）。"
      },
      "category": {
        "type": "string",
        "enum": [
          "__CATEGORY_IDS__"
        ],
        "description": "可选：新的分类。"
      },
      "status": {
        "type": "string",
        "enum": [
          "inbox",
          "todo",
          "done"
        ],
        "description": "可选：新的状态。"
      }
    },
    "run": "update"
  }
];

/** @param {string} text */
function textBlock(text) {
  return [{ type: 'text', text }];
}

/** @param {string} iso */
function shortTime(iso) {
  const raw = typeof iso === 'string' ? iso : '';
  return raw ? raw.slice(0, 16).replace('T', ' ') : '';
}

/**
 * 把占位 enum 换成真实分类 id（深拷贝，别污染常量）。
 * @param {any} parameters
 */
function withCategories(parameters) {
  const clone = JSON.parse(JSON.stringify(parameters));
  for (const key of Object.keys(clone)) {
    if (Array.isArray(clone[key].enum) && clone[key].enum[0] === '__CATEGORY_IDS__') clone[key].enum = CATEGORY_IDS.slice();
  }
  return clone;
}

/**
 * 取某个工具的描述对象（给测试与调试用）。
 * @param {string} name
 */
export function toolSpec(name) {
  const spec = TOOL_SPECS.find((s) => s.name === name);
  return spec ? { name: spec.name, description: spec.description, parameters: withCategories(spec.parameters) } : undefined;
}

export const TOOL_NAMES = TOOL_SPECS.map((s) => s.name);

async function runAdd(args, getPaths) {
  const item = addItem(getPaths(), { text: args.text, category: args.category, source: 'agent' });
  return (
    '已记入思维胶囊（状态：' + STATUS_LABELS[item.status] + '，分类：' + categoryLabel(item.category) + '）\n' +
    'id: ' + item.id + '\n' +
    '内容：' + item.text
  );
}

async function runList(args, getPaths) {
  const result = listItems(getPaths(), {
    status: args.status || 'all',
    category: args.category,
    limit: Number.isFinite(Number(args.limit)) ? Number(args.limit) : 20,
  });
  const counts = result.counts;
  const head =
    '思维胶囊：共 ' + counts.total + ' 条（未整理 ' + counts.inbox + ' / 待办 ' + counts.todo + ' / 已完成 ' + counts.done + '），本次返回 ' + result.items.length + ' 条。';
  if (!result.items.length) return head + '\n（没有匹配的胶囊）';
  const lines = result.items.map((item, index) => {
    return (
      index + 1 + '. [' + STATUS_LABELS[item.status] + ' · ' + categoryLabel(item.category) + ' · ' + shortTime(item.createdAt) + ' · ' + (item.source === 'agent' ? 'agent 记录' : '用户记录') + ']\n' +
      '   ' + String(item.text).replace(/\r?\n/g, '\n   ') + '\n' +
      '   id: ' + item.id
    );
  });
  return head + '\n\n' + lines.join('\n\n');
}

async function runUpdate(args, getPaths) {
  const item = updateItem(getPaths(), args.id, { text: args.text, category: args.category, status: args.status });
  return '已更新：状态=' + STATUS_LABELS[item.status] + '，分类=' + categoryLabel(item.category) + '\n内容：' + item.text + '\nid: ' + item.id;
}

const RUNNERS = { add: runAdd, list: runList, update: runUpdate };

/**
 * 注册三个工具，返回清理函数。
 *
 * @param {any} ctx 已能拿到 tools 服务的作用域
 * @param {() => { dir: string, file: string, backup: string }} getPaths
 * @returns {() => void}
 */
export function registerCapsuleTools(ctx, getPaths) {
  /** @type {Array<() => void>} */
  const disposers = [];

  for (const spec of TOOL_SPECS) {
    const run = RUNNERS[spec.run];
    const registration = {
      ...toolSpec(spec.name),
      output: {
        schema: { type: 'string' },
        render: (_args, value) => textBlock(String(value || '')),
      },
      execute: (args) => run(args && typeof args === 'object' ? args : {}, getPaths),
    };
    disposers.push(ctx.tools.register(registration));
  }

  return () => {
    for (const dispose of disposers) {
      try {
        if (typeof dispose === 'function') dispose();
      } catch (err) {
        /* noop */
      }
    }
    disposers.length = 0;
  };
}
