{
  "name": "dsh-thought-capsule",
  "version": "0.2.0",
  "type": "module",
  "description": "思维胶囊：干活时想到的点子 / 待试插件，一句话记下来，自动分类进待办。带侧边栏面板、Agent 工具与命令行。",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.2",
    "react": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/cli.mjs",
    "test:cli": "node test/cli.mjs"
  },
  "bin": {
    "dsh-thought-capsule": "lib/cli.js"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "capsule",
    "todo",
    "notes",
    "cli"
  ],
  "license": "MIT"
}
